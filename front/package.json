{
  "name": "front-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh ./scripts/set_dev_properties.sh; vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "build_for_beta": "sh ./scripts/set_beta_properties.sh; npm run build",
    "build_for_prod": "sh ./scripts/set_prod_properties.sh; npm run build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.0.0",
    "@vueform/multiselect": "^2.6.8",
    "axios": "^1.7.2",
    "bootstrap": "^5.3.3",
    "chart.js": "^4.4.3",
    "keycloak-js": "^26.0.0",
    "neverthrow": "^8.0.0",
    "pinia": "^4.0.0",
    "vue": "^3.4.31",
    "vue-chartjs": "^5.3.1",
    "vue-i18n": "^11.0.0",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@babel/types": "^8.0.0",
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@tsconfig/node20": "^20.1.4",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^26.0.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^29.0.0",
    "less": "^4.2.0",
    "npm-run-all2": "^9.0.0",
    "prettier": "^3.2.5",
    "typescript": "~6.0.0",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.0",
    "vue-tsc": "^3.0.0"
  }
}